# Copy to .env and fill in values:  cp .env.example .env

# === Tailscale =============================================================
# Reusable auth key from https://login.tailscale.com/admin/settings/keys.
# Recommended settings: Reusable + Pre-approved + 90d expiry + tagged.
TS_AUTHKEY=tskey-auth-REPLACE_ME

# Hostname that appears in your tailnet. Pick anything unique.
TS_HOSTNAME=imgproxy-web

# Extra args passed to `tailscale up`. Useful for tags, exit-node opt-in, etc.
TS_EXTRA_ARGS=--advertise-tags=tag:container

# === imgproxy ==============================================================
# Generous limits suited for batch conversion of typical photos.
IMGPROXY_MAX_SRC_RESOLUTION=100
IMGPROXY_MAX_SRC_FILE_SIZE=104857600
IMGPROXY_MAX_ANIMATION_FRAMES=1024

# Optional: enable HMAC URL signing. Use the same key/salt for both services.
# Generate with: openssl rand -hex 32
IMGPROXY_KEY=
IMGPROXY_SALT=

# === imgproxy-web sidecar ==================================================
IMGPROXY_WEB_MAX_UPLOAD_SIZE=104857600
IMGPROXY_WEB_MAX_BATCH=200

# Optional: bearer token sent to imgproxy if it has IMGPROXY_SECRET set.
IMGPROXY_WEB_BEARER=
